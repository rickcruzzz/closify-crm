# Copie para .env.local e preencha. Nenhum valor real entra neste arquivo —
# ele é versionado. As mesmas chaves precisam existir na Vercel
# (Settings > Environment Variables) para o build de produção.

# ---------------------------------------------------------------------------
# Supabase — Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# A *publishable key* (antiga anon key). Vai para o browser: é pública por
# design, e o que protege os dados é a RLS, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# A *secret key* (antiga service_role). NUNCA vai para o browser — ignora RLS
# por completo. Fica na mesma tela da publishable e nasce oculta, exigindo
# "Reveal": colar a publishable aqui derruba o webhook do Asaas com 500,
# porque a escrita passa a ser barrada pela RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Asaas
# ---------------------------------------------------------------------------
# No .env.local a chave começa com "$" e precisa de barra invertida antes
# (\$aact_...). Na Vercel vai sem a barra.
ASAAS_API_KEY=

# Token que o webhook exige no header `asaas-access-token`. Precisa ser o
# mesmo valor cadastrado no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=

# Opcional. Sem isso o código usa https://api.asaas.com/v3 (produção).
# Para sandbox: https://api-sandbox.asaas.com/v3
# ASAAS_API_URL=

# ---------------------------------------------------------------------------
# Resend
# ---------------------------------------------------------------------------
# Usada só pelos e-mails que o PRÓPRIO app dispara (convite de colaborador,
# em lib/workspace/actions.ts).
#
# Os e-mails de autenticação — confirmação de cadastro e recuperação de senha —
# NÃO passam por esta chave: quem os gera é o Supabase Auth. Para eles saírem
# do domínio próprio, configure em
#   Supabase > Project Settings > Authentication > SMTP Settings:
#     Host: smtp.resend.com   Port: 465   User: resend
#     Password: esta mesma RESEND_API_KEY
#     Sender: suporte@velofunil.com.br
# Sem isso, o Supabase usa o SMTP compartilhado dele, que tem limite baixo de
# envio e cai em spam com frequência.
#
# O domínio precisa estar verificado no Resend (SPF em `send`, DKIM em
# `resend._domainkey`), senão o envio falha em ambos os caminhos.
RESEND_API_KEY=re_...

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Base dos links absolutos (convites, callbacks de auth). Sem barra no final.
# Em produção precisa ser a URL pública real, senão os convites por e-mail
# apontam para localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Integrações — WhatsApp, Google Calendar, Gmail
# ---------------------------------------------------------------------------
# Sem estas variáveis os cards de integração aparecem normalmente em "Não
# conectado" — nada quebra, só o botão "Conectar" falha ao tentar.

# 32 bytes em hexadecimal (64 caracteres) — gere com: openssl rand -hex 32
# Cifra os tokens antes de gravar em integration_connections. Perder esta
# chave torna toda conexão existente irrecuperável (precisa reconectar).
INTEGRATIONS_ENCRYPTION_KEY=

# Google Cloud Console > APIs & Services > Credentials. Pode ser o MESMO
# client já usado para o login com Google, desde que o redirect URI abaixo
# esteja na allowlist dele: Calendar/Gmail usam um fluxo próprio, separado do
# OAuth de login (aquele não persiste refresh token para uso em background).
# Redirect URI a cadastrar: {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
# Ativar também: Google Calendar API e Gmail API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta for Developers > seu App > WhatsApp > Configuração. O App ID não é
# secreto (por isso existe também com prefixo NEXT_PUBLIC_, pro SDK rodar no
# browser) — só o App Secret é.
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=

# Meta for Developers > seu App > WhatsApp > Configuração > Embedded Signup.
# Também precisa existir com prefixo NEXT_PUBLIC_ (mesmo motivo do App ID).
META_WHATSAPP_CONFIG_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=

# Valor à sua escolha — cadastre o MESMO valor no painel do Meta App em
# WhatsApp > Configuração > Webhook > Verify Token.
# URL do webhook a cadastrar lá: {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
META_WEBHOOK_VERIFY_TOKEN=

# Meta Business > Gerenciador de Eventos > seu Pixel > Configurações. Não é
# secreto (fica visível no HTML pra qualquer visitante), mas precisa do
# mesmo valor na Vercel pra funcionar em produção.
NEXT_PUBLIC_META_PIXEL_ID=
